# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# Which settings module to use: config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me

DJANGO_DEBUG=true

# Comma-separated host names this site is served from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins (with scheme) trusted for CSRF, e.g. https://laundry.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database URL. Default (unset) is SQLite at ./db.sqlite3.
# PostgreSQL example: postgres://laundry:password@localhost:5432/laundry
DATABASE_URL=sqlite:///db.sqlite3

# Production only (optional): disable if HTTPS redirect is done by the proxy.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=2592000

# Demo data (python manage.py seed_demo). Fake accounts only; change them on a
# public demo server.
SEED_DEMO_STAFF_PASSWORD=demo-staff-password
SEED_DEMO_RESIDENT_PIN=123456

# Slug of the dormitory residents log in to (the pilot has one dormitory).
DEFAULT_DORMITORY_SLUG=demo

# --- Deployment (see docs/plans/admin-and-payments.md, "Readiness gates") ---

# Demo instance with fake data only: banner on every page, noindex for search
# engines. Production refuses to start with DEMO_MODE=false unless
# PILOT_READY=true. A demo hosted outside Russia must always use DEMO_MODE=true.
DEMO_MODE=false

# Set to true only when every pilot gate item is done (Russian hosting,
# tested encrypted off-site backups, monitoring, second person with access,
# retention decision, 152-FZ formalities, `manage.py check --deploy` clean).
PILOT_READY=false

# Largest request body in bytes (uploads included). The web server's limit
# (nginx client_max_body_size) must be the same. Default 20 MB.
MAX_UPLOAD_BYTES_HARD=20971520

# Set to false on servers so a stray .env file is never read; real environment
# variables are used instead.
# DJANGO_READ_DOT_ENV=true
