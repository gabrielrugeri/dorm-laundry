# Backup and alert settings for the pilot VPS. Copy to
# /etc/dorm-laundry/backup.env (owner root, group dorm-laundry, mode 640).
# No secrets in this file: passwords and keys live in their own files.

# age PUBLIC key of the administration (age-keygen prints it as "age1...").
# The matching private key is NOT on the server: two people keep it offline.
BACKUP_AGE_RECIPIENT=age1replacewiththeadministrationspublickey

# rclone remote and folder for the off-site copies; the remote is defined in
# the rclone config below (e.g. a Russian S3-compatible storage).
BACKUP_RCLONE_REMOTE=s3backup:dorm-laundry-backups
RCLONE_CONFIG=/etc/dorm-laundry/rclone.conf

BACKUP_DIR=/srv/dorm-laundry/backups
BACKUP_KEEP_LOCAL_DAYS=7
BACKUP_KEEP_REMOTE_DAYS=35
# Optional: an uptime checker's heartbeat URL, pinged after each backup.
BACKUP_HEARTBEAT_URL=

# Alert e-mails through a Russian mail provider's SMTP (with authentication).
ALERT_EMAIL_TO=it-admin@example.ru
ALERT_SMTP_HOST=smtp.example.ru
ALERT_SMTP_PORT=465
ALERT_SMTP_STARTTLS=off
ALERT_SMTP_USER=laundry-alerts@example.ru
ALERT_SMTP_PASSWORD_FILE=/etc/dorm-laundry/smtp-password
