# App settings for the pilot VPS. Copy to /etc/dorm-laundry/env (owner root,
# group dorm-laundry, mode 640) and fill in. Never commit the real file.
# The full list with explanations is in the repository's .env.example.

DJANGO_SECRET_KEY=generate-a-long-random-value
# The app's public address, for the links `manage.py dormitory_admin` prints.
PUBLIC_BASE_URL=https://laundry.example.ru
# Secret mixed into every resident PIN hash (32+ random characters):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Back it up with the other secrets, NOT with the database backups: losing or
# changing it makes every resident PIN invalid (docs/SECURITY.md).
PIN_PEPPER=generate-a-different-long-random-value
DJANGO_ALLOWED_HOSTS=laundry.example.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://laundry.example.ru
DATABASE_URL=postgres://dorm_laundry:password@localhost:5432/dorm_laundry
PRIVATE_MEDIA_ROOT=/srv/dorm-laundry/private_media

# Real data: no demo banner. The app refuses to start with DEMO_MODE=false
# until PILOT_READY=true, which is set only when every pilot gate item in
# docs/DEPLOYMENT.md is done.
DEMO_MODE=false
PILOT_READY=false

# Must equal nginx client_max_body_size (deploy/nginx/dorm-laundry.conf).
MAX_UPLOAD_BYTES_HARD=20971520

KEYS_ENABLED=false
DEFAULT_DORMITORY_SLUG=dorm-1
