# Runtime dependencies. Edit this file, then regenerate requirements.txt with:
#   pip-compile requirements.in
Django>=5.2,<5.3   # 5.2 is an LTS release
django-environ     # read settings from environment variables / .env
whitenoise         # serve static files from our own server
psycopg[binary]    # PostgreSQL driver (production)
gunicorn           # production WSGI server
Pillow             # check and re-save uploaded images (receipts, payment QR code)
segno              # QR codes as SVG, made on our server (the printable poster)
