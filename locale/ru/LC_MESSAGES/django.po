msgid "This booking has already started and can no longer be cancelled."
msgstr "Это бронирование уже началось, отменить его нельзя."

msgid "You are not allowed to change this booking."
msgstr "У вас нет прав изменять это бронирование."

msgid "Your booking is confirmed."
msgstr "Бронирование подтверждено."

