msgstr "PIN-код"

msgid "Invalid student code or PIN."
msgstr "Неверный студенческий код или PIN-код."

msgid "Too many failed attempts. Please try again later."
msgstr "Слишком много неудачных попыток. Попробуйте позже."

msgid "Log in"
msgstr "Войти"

msgid ""
"First time here? Ask the dormitory administration for your activation link."
msgstr ""
"Впервые здесь? Попросите у администрации общежития ссылку для активации."

msgid "Log out"
msgstr "Выйти"

msgid "Today's key schedule"
msgstr "Выдача ключей сегодня"

msgid "The key schedule will appear here."
msgstr "Здесь появится расписание выдачи ключей."

msgid "Administration"
msgstr "Администрирование"

